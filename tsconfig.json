{
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "strict": true,
    "importHelpers": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "downlevelIteration": true,
    "declaration": false,
    "jsx": "react-jsx",
    "allowJs": true,
    "newLine": "lf",
    "baseUrl": ".",
    "paths": {
      "copy-runtime": ["./shared/copy-runtime/src/index.ts"],
      "copy-runtime/*": ["./shared/copy-runtime/src/*"],
      "copy/*": ["./scripts/copy/*"],
      "copy-currency/*": ["./scripts/copy-currency/*"]
    }
  },
  "include": ["scripts/*/src", "extensions/*/src", "shared/*/src"],
  "exclude": ["node_modules", "dist"]
}
